// Este archivo es el "plano" de la base de datos.
// Prisma lo lee y crea las tablas por nosotros.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Empezamos con SQLite (un archivo, sin instalar nada).
  // Para producción se cambia a "postgresql" y listo.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String // nunca guardamos la contraseña real, solo su "huella"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks Task[] // un usuario tiene muchas tareas
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | DONE
  priority    String    @default("MEDIUM")  // LOW | MEDIUM | HIGH
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Cada tarea pertenece a un usuario. Si se borra el usuario, se borran sus tareas.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, priority])
}
