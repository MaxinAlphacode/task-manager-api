// Este archivo es el "plano" de la base de datos.
// Prisma lo lee, crea las tablas (migraciones) y genera un cliente con tipos.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // La URL de conexión vive en prisma.config.ts (lee DATABASE_URL del .env).
}

// Con PostgreSQL podemos usar enums reales: la base de datos misma
// rechaza un valor como "URGENTE", no solo nuestro código.
enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

// El orden importa: al ordenar por prioridad, LOW < MEDIUM < HIGH.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String // nunca guardamos la contraseña real, solo su "huella"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks Task[] // un usuario tiene muchas tareas
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String       @db.VarChar(120)
  description String?      @db.VarChar(1000)
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Cada tarea pertenece a un usuario. Si se borra el usuario, se borran sus tareas.
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, priority])
}
