# Copia este archivo como .env y ajusta los valores
NODE_ENV=development
PORT=4000

# Base de datos (PostgreSQL en Docker, puerto 5433 en tu PC)
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=taskmanager
POSTGRES_DB=taskmanager
DATABASE_URL="postgresql://taskmanager:taskmanager@localhost:5433/taskmanager"

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-32+-caracteres"
JWT_EXPIRES_IN=1h
